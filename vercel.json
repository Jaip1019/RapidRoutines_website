{
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://new-5t2n.onrender.com/api/$1"
    },
    {
      "src": "/dashboard(?:/.*)?",
      "dest": "/dashboard/index.html"
    },
    {
      "src": "/([A-Za-z0-9-]+)/?",
      "dest": "/$1.html"
    }
  ]
}
