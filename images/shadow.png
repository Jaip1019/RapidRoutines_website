		<style id="wp-custom-css">
			/* Dashboard container */
.dashboard-container {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 20px;
}

/* Button container */
.custom-menu-button {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 120px;
    margin: 0 auto;
}

/* Button styles */
.custom-menu-button a {
    /* Base styles */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    background-color: #1e628c;
    padding: 24px 32px;  /* Increased padding evenly */
    border-radius: 50px;
    font-weight: 500;
    text-decoration: none;
    height: 40px;        /* Set specific height */
    min-width: 132px;
    font-size: 1.1em;    /* Slightly larger text */
    
    /* Smooth transition */
    transition: all 0.3s ease;
    
    /* Modern shadow */
    box-shadow: 0 4px 15px rgba(56, 182, 255, 0.2);
    
    /* Optional: prevent text wrapping */
    white-space: nowrap;
    
    /* Ensure content is centered vertically */
    line-height: 1;
    margin: 0;
}

/* Hover effects */
.custom-menu-button a:hover {
    color: #ffffff;
    background-color: #1e628c;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(56, 182, 255, 0.3);
}

/* Icon hover animation */
.custom-menu-button a:hover:before {
    transform: scale(1.1);
}

/* Active state */
.custom-menu-button a:active {
    transform: translateY(1px);
    box-shadow: 0 2px 10px rgba(56, 182, 255, 0.2);
}

/* Focus state for accessibility */
.custom-menu-button a:focus {
    outline: none;
    box-shadow: 0 0 0 3px rgba(56, 182, 255, 0.3), 0 4px 15px rgba(56, 182, 255, 0.2);
}

/* Remove default hover styles */
.custom-menu-button:hover {
    text-decoration: none;
    color: #ffffff !important;
}

/* Dark mode styles */
@media (prefers-color-scheme: dark) {
    .custom-menu-button a {
        background-color: #38b6ff;
        box-shadow: 0 4px 15px rgba(56, 182, 255, 0.3);
    }
    
    .custom-menu-button a:hover {
        background-color: #35a8ea;
        box-shadow: 0 6px 20px rgba(56, 182, 255, 0.4);
    }
}

/* Responsive adjustments */
@media (max-width: 768px) {
    .custom-menu-button a {
        height: 70px;
        padding: 20px 28px;
        font-size: 1em;
    }
}

/** Start Block Kit CSS: 144-3-3a7d335f39a8579c20cdf02f8d462582 **/

.envato-block__preview{overflow: visible;}

/* Envato Kit 141 Custom Styles - Applied to the element under Advanced */

.elementor-headline-animation-type-drop-in .elementor-headline-dynamic-wrapper{
	text-align: center;
}
.envato-kit-141-top-0 h1,
.envato-kit-141-top-0 h2,
.envato-kit-141-top-0 h3,
.envato-kit-141-top-0 h4,
.envato-kit-141-top-0 h5,
.envato-kit-141-top-0 h6,
.envato-kit-141-top-0 p {
	margin-top: 0;
}

.envato-kit-141-newsletter-inline .elementor-field-textual.elementor-size-md {
	padding-left: 1.5rem;
	padding-right: 1.5rem;
}

.envato-kit-141-bottom-0 p {
	margin-bottom: 0;
}

.envato-kit-141-bottom-8 .elementor-price-list .elementor-price-list-item .elementor-price-list-header {
	margin-bottom: .5rem;
}

.envato-kit-141.elementor-widget-testimonial-carousel.elementor-pagination-type-bullets .swiper-container {
	padding-bottom: 52px;
}

.envato-kit-141-display-inline {
	display: inline-block;
}

.envato-kit-141 .elementor-slick-slider ul.slick-dots {
	bottom: -40px;
}

/** End Block Kit CSS: 144-3-3a7d335f39a8579c20cdf02f8d462582 **/



